# Optional infrastructure overrides only. This file is not required.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
# OMNIX_IMAGE=ghcr.io/your-owner/your-repository:latest

# OMNIX_DATA_DIR=./data

# Optional: exact trusted tunnel peers, never a wildcard or a shared LAN.
# The tunnel must overwrite the selected client-IP header.
# TRUSTED_PROXY_CIDRS=192.0.2.10/32
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
API_MEMORY_LIMIT=1g
API_CPUS=2
