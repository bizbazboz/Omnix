{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Omnix: production start",
      "type": "shell",
      "command": "docker compose up -d --build --wait",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Omnix: production stop",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "Omnix: isolated tests",
      "type": "shell",
      "command": "python scripts/test.py",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Omnix: logs",
      "type": "shell",
      "command": "docker compose logs --follow --tail=80",
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
